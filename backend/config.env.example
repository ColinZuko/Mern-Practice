# Copy this file to config.env and fill in the values. Never commit config.env.
# On Render, the same names are set under the service's Environment tab.

# MongoDB Atlas connection string (Atlas > Connect > Drivers)
ATLAS_URI=

# Long random string used to sign logins. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SECRETKEY=

# AWS keys for the colinblogstorage S3 bucket (photos and backups)
MY_AWS_ACCESS_KEY=
MY_AWS_SECRET_KEY=

# Resend (resend.com) for verification and password-reset emails.
# Without RESEND_API_KEY, emails are printed to the server log instead.
RESEND_API_KEY=
EMAIL_FROM=Pickle & Pan <hello@pickleandpan.com>
SITE_URL=https://pickleandpan.com
# Public address of this API, used for one-click unsubscribe links in emails
API_URL=https://api.pickleandpan.com

# Optional: extra sites allowed to call the API, comma-separated
# (pickleandpan.com and localhost:5173 are always allowed)
FRONTEND_URL=

# Local port (Render sets its own)
PORT=5000
